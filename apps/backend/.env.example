# ============================================================
# BACKEND — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Base de datos PostgreSQL ──────────────────────────────────
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura_rest"

# URL usada por Prisma al generar/migrar el schema de TENANT.
# Apunta al mismo servidor pero con ?schema=tenant_ejemplo para preview.
# En producción se construye dinámicamente: DATABASE_URL + ?schema=tenant_<slug>
TENANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura_rest?schema=tenant_ejemplo"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="cambia_este_secreto_por_uno_seguro_en_produccion"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="cambia_este_refresh_secreto_en_produccion"
JWT_REFRESH_EXPIRES_IN="7d"

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGINS="http://localhost:3030,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004,http://localhost:5005,http://localhost:5006,http://localhost:5007,http://localhost:5008"

# ── AWS S3 (tickets PDF e imágenes) ──────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ── Bcrypt ────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
