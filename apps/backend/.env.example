# ============================================================
# BACKEND — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ⚠️  NUNCA comitees .env real. .env ya está en .gitignore.
# ⚠️  NUNCA uses estos placeholders en producción.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Base de datos PostgreSQL ──────────────────────────────────
# ⚠️  CAMBIA usuario/contraseña en producción. Usa Secrets Manager / env vars.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura_rest"

# Solo para uso manual del CLI de Prisma (prisma migrate dev/generate
# --schema=prisma/tenant/schema.prisma) contra un schema de ejemplo.
# NO se lee en runtime: TenantPrismaService arma la URL de cada tenant
# dinámicamente a partir de DATABASE_URL + su schemaName (ver
# src/database/tenant-prisma.service.ts).
TENANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura_rest?schema=tenant_ejemplo"

# ── JWT ───────────────────────────────────────────────────────
# ⚠️  GENERA secrets únicos para producción:
#        node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  JWT_SECRET y JWT_REFRESH_SECRET deben ser DISTINTOS.
# ⚠️  En producción: mínimo 32 caracteres, sin placeholders.
# El backend valida estas variables al iniciar y falla si son inválidas.
JWT_SECRET="dev_only_local_secret_not_for_production!!"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="dev_only_local_refresh_secret_not_for_production!!"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Auth Refresh Throttle ────────────────────────────────────
# Límite de peticiones a POST /auth/refresh por ventana de tiempo.
# Default: 10 requests por 60 s
AUTH_REFRESH_THROTTLE_LIMIT=10
AUTH_REFRESH_THROTTLE_TTL_MS=60000

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. Se aplican trim y normalización.
# Ejemplo local:
#   CORS_ORIGINS=http://localhost:3030, http://localhost:5001, http://localhost:5014
# Ejemplo producción:
#   CORS_ORIGINS=https://app.example.com, https://admin.example.com
# En desarrollo, si CORS_ORIGINS está vacío se usan los puertos locales por defecto.
# En producción CORS_ORIGINS es OBLIGATORIO — sin valor no se permite ningún origen.
CORS_ORIGINS="http://localhost:3030,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5004,http://localhost:5005,http://localhost:5006,http://localhost:5007,http://localhost:5008,http://localhost:5014"

# ── AWS S3 (tickets PDF e imágenes) ──────────────────────────
# ⚠️  Usa roles IAM o variables de entorno en producción, no credenciales estáticas.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ── Cloudinary (imágenes de menu items) ──────────────────────
# ⚠️  El backend valida estas variables al iniciar y falla si faltan.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Bcrypt ────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ── Tenant Prisma Pool ───────────────────────────────────────
# Número máximo de PrismaClient cacheados simultáneamente.
# Ajustar según max_connections de PostgreSQL, connection_limit
# por PrismaClient y número de réplicas del backend.
# Default: 10  (para desarrollo)
TENANT_PRISMA_MAX_CLIENTS=10

# Tiempo máximo de inactividad (ms) antes de cerrar y eliminar
# un PrismaClient del caché.
# Default: 300000 (5 minutos)
TENANT_PRISMA_CLIENT_TTL_MS=300000

# Intervalo (ms) entre limpiezas periódicas de clientes
# expirados por TTL. No afecta la evicción por límite,
# que ocurre en el momento de crear un nuevo cliente.
# Default: 60000 (1 minuto)
TENANT_PRISMA_CLEANUP_INTERVAL_MS=60000

# ── Swagger ──────────────────────────────────────────────────
# Habilita la documentación Swagger en /api/docs.
# development → true (por defecto)
# test        → true (por defecto)
# production  → false (por defecto)
# Si se define, tiene prioridad sobre el valor por defecto:
#   SWAGGER_ENABLED=true  → habilita Swagger incluso en producción
#   SWAGGER_ENABLED=false → deshabilita Swagger incluso en desarrollo
SWAGGER_ENABLED=true
