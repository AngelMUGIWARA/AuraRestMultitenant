{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "generated/**/*.js",   "watchAssets": true },
      { "include": "generated/**/*.d.ts", "watchAssets": true },
      { "include": "generated/**/*.json", "watchAssets": true }
    ]
  }
}
