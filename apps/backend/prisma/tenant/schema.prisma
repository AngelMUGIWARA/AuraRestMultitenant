// ============================================================
// SCHEMA POR TENANT — aplicado a cada schema de restaurante.
// Migraciones: prisma/tenant/migrations/
// Uso dev: npx prisma migrate dev --schema=prisma/tenant/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ── Enumeraciones ────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  WAITER
  CASHIER
  KITCHEN_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MenuItemStatus {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_STOCK
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  BUY_X_GET_Y
  FREE_ITEM
  SPECIAL_PRICE
  CATEGORY_PERCENTAGE
  CATEGORY_FIXED
}

enum TipMethod {
  NONE
  PERCENTAGE
  FIXED
  CASH
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum KitchenItemStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum KitchenPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
}

enum CashSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CashMovementType {
  OPENING_FLOAT
  CASH_PAYMENT
  CASH_REFUND
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  CLOSING
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CANCELLED
  ARRIVED
  COMPLETED
  NO_SHOW
}

// ── Inventario ───────────────────────────────────────────────

enum InventoryUnit {
  KG
  G
  L
  ML
  PIECE
  PACKAGE
  BOX
}

enum InventoryMovementType {
  PURCHASE     // Entrada por compra a proveedor
  CONSUMPTION  // Salida por consumo en cocina
  ADJUSTMENT   // Ajuste manual (conteo físico)
  WASTE        // Merma / desperdicio
  TRANSFER_IN  // Entrada por traslado desde otra sucursal
  TRANSFER_OUT // Salida por traslado hacia otra sucursal
}

// ── Modelos ──────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String     @map("password_hash")
  role               UserRole   @default(WAITER)
  status             UserStatus @default(ACTIVE)
  phone              String?
  avatarUrl          String?    @map("avatar_url")
  voiceUsername      String?    @unique @map("voice_username")
  voiceSeedHash      String?    @map("voice_seed_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  // Relaciones adicionales para gestión por sucursal y auditoría
  userBranches UserBranch[]
  activityLogs ActivityLog[]

  orders       Order[]
  reservations Reservation[]
  tips         Tip[]
  refunds      Refund[]
  receipts     Receipt[]

  cashSessionsOpened CashSession[]  @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]  @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]
  cashCounts         CashCount[]

  inventoryMovements InventoryMovement[]

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuItems           MenuItem[]
  promotionCategories PromotionCategory[]

  @@map("categories")
}

model MenuItem {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  imageUrl    String?        @map("image_url")
  imagePublicId String?      @map("image_public_id")
  status      MenuItemStatus @default(AVAILABLE)
  isAvailable Boolean        @default(true) @map("is_available")
  categoryId  String         @map("category_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  category          Category           @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  promotionItems    PromotionItem[]
  recipeIngredients RecipeIngredient[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("menu_items")
}

model RestaurantTable {
  id           String      @id @default(cuid())
  number       Int
  name         String?
  capacity     Int
  status       TableStatus @default(AVAILABLE)
  locationZone String?     @map("location_zone")
  isActive     Boolean     @default(true) @map("is_active")
  branchId     String      @map("branch_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orders       Order[]
  reservations Reservation[]

  @@unique([number, branchId])
  @@index([branchId])
  @@map("tables")
}

model Order {
  id                   String             @id @default(cuid())
  folio                String             @unique
  tableId              String?            @map("table_id")
  branchId             String?            @map("branch_id")
  userId               String             @map("user_id")
  customerName         String?            @map("customer_name")
  type                 OrderType          @default(DINE_IN)
  status               OrderStatus        @default(PENDING)
  paymentStatus        OrderPaymentStatus @default(UNPAID) @map("payment_status")
  notes                String?
  subtotal             Decimal            @db.Decimal(10, 2)
  promotionAmount      Decimal?           @map("promotion_amount") @db.Decimal(10, 2)
  promotedSubtotal     Decimal?           @map("promoted_subtotal") @db.Decimal(10, 2)
  discountAmount       Decimal?           @map("discount_amount") @db.Decimal(10, 2)
  taxableSubtotal      Decimal?           @map("taxable_subtotal") @db.Decimal(10, 2)
  tax                  Decimal            @db.Decimal(10, 2)
  totalBeforeTip       Decimal?           @map("total_before_tip") @db.Decimal(10, 2)
  tipAmount            Decimal?           @map("tip_amount") @db.Decimal(10, 2)
  cashTipAmount        Decimal?           @map("cash_tip_amount") @db.Decimal(10, 2)
  chargeableTipAmount  Decimal?           @map("chargeable_tip_amount") @db.Decimal(10, 2)
  total                Decimal            @db.Decimal(10, 2)
  amountDueForPayments Decimal?           @map("amount_due_for_payments") @db.Decimal(10, 2)
  discountId           String?            @map("discount_id")
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  /// @deprecated Order.promotionId is deprecated; use OrderPromotion relation for order promotions.
  promotionId String? @map("promotion_id")

  table           RestaurantTable? @relation(fields: [tableId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  discount        Discount?        @relation(fields: [discountId], references: [id])
  promotion       Promotion?       @relation(fields: [promotionId], references: [id])
  tip             Tip?
  orderItems      OrderItem[]
  orderPromotions OrderPromotion[]
  payments        Payment[]
  refunds         Refund[]
  kitchenTicket   KitchenTicket?
  receipt         Receipt?

  @@index([userId])
  @@index([tableId])
  @@index([branchId])
  @@index([discountId])
  @@index([promotionId])
  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(cuid())
  orderId                String   @map("order_id")
  menuItemId             String   @map("menu_item_id")
  quantity               Int
  unitPrice              Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal               Decimal  @db.Decimal(10, 2)
  promotionId            String?  @map("promotion_id")
  promotionNameSnapshot  String?  @map("promotion_name_snapshot")
  promotionTypeSnapshot  String?  @map("promotion_type_snapshot")
  promotionValueSnapshot Decimal? @map("promotion_value_snapshot") @db.Decimal(10, 2)
  promotionQuantity      Int?     @map("promotion_quantity")
  promotionAmount        Decimal? @map("promotion_amount") @db.Decimal(10, 2)
  originalUnitPrice      Decimal? @map("original_unit_price") @db.Decimal(10, 2)
  effectiveUnitPrice     Decimal? @map("effective_unit_price") @db.Decimal(10, 2)
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at")

  order        Order               @relation(fields: [orderId], references: [id])
  menuItem     MenuItem            @relation(fields: [menuItemId], references: [id])
  promotion    Promotion?          @relation(fields: [promotionId], references: [id])
  kitchenItems KitchenTicketItem[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([promotionId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @map("order_id")
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  reference      String?
  tipAmount      Decimal?      @map("tip_amount") @db.Decimal(10, 2)
  idempotencyKey String?       @unique @map("idempotency_key")
  ticketPdfUrl   String?       @map("ticket_pdf_url")
  processedAt    DateTime?     @map("processed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id])
  tip     Tip?
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model KitchenTicket {
  id          String              @id @default(cuid())
  orderId     String              @unique @map("order_id")
  branchId    String?             @map("branch_id")
  status      KitchenTicketStatus @default(PENDING)
  priority    KitchenPriority     @default(NORMAL)
  version     Int                 @default(1)
  startedAt   DateTime?           @map("started_at")
  readyAt     DateTime?           @map("ready_at")
  deliveredAt DateTime?           @map("delivered_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  order  Order               @relation(fields: [orderId], references: [id])
  branch Branch?             @relation(fields: [branchId], references: [id])
  items  KitchenTicketItem[]

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id           String            @id @default(cuid())
  ticketId     String            @map("ticket_id")
  orderItemId  String            @map("order_item_id")
  menuItemName String            @map("menu_item_name")
  quantity     Int
  notes        String?
  status       KitchenItemStatus @default(PENDING)
  version      Int               @default(1)
  startedAt    DateTime?         @map("started_at")
  readyAt      DateTime?         @map("ready_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_ticket_items")
}

model Reservation {
  id              String            @id @default(cuid())
  branchId        String            @map("branch_id")
  tableId         String            @map("table_id")
  userId          String?           @map("user_id")
  guestName       String            @map("guest_name")
  guestPhone      String?           @map("guest_phone")
  guestEmail      String?           @map("guest_email")
  partySize       Int               @map("party_size")
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(60) @map("duration_minutes")
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  table RestaurantTable @relation(fields: [tableId], references: [id])
  user  User?           @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([tableId])
  @@index([userId])
  @@index([scheduledAt])
  @@index([branchId, tableId, scheduledAt])
  @@index([branchId, status, scheduledAt])
  @@map("reservations")
}

model Discount {
  id          String       @id @default(cuid())
  name        String
  description String?
  code        String?      @unique
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2)
  isActive    Boolean      @default(true) @map("is_active")
  branchId    String?      @map("branch_id")
  startsAt    DateTime?    @map("starts_at")
  endsAt      DateTime?    @map("ends_at")
  minPurchase Decimal?     @map("min_purchase") @db.Decimal(10, 2)
  maxAmount   Decimal?     @map("max_amount") @db.Decimal(10, 2)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  branch Branch? @relation(fields: [branchId], references: [id])
  orders Order[]

  @@index([branchId])
  @@map("discounts")
}

model Promotion {
  id           String        @id @default(cuid())
  name         String
  description  String?
  type         PromotionType
  value        Decimal       @db.Decimal(10, 2)
  minPurchase  Decimal?      @map("min_purchase") @db.Decimal(10, 2)
  maxAmount    Decimal?      @map("max_amount") @db.Decimal(10, 2)
  specialPrice Decimal?      @map("special_price") @db.Decimal(10, 2)
  buyQuantity  Int?          @map("buy_quantity")
  getQuantity  Int?          @map("get_quantity")
  startsAt     DateTime?     @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  startMinute  Int?          @map("start_minute")
  endMinute    Int?          @map("end_minute")
  priority     Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  branchId     String?       @map("branch_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  branch              Branch?             @relation(fields: [branchId], references: [id])
  promotionCategories PromotionCategory[]
  promotionItems      PromotionItem[]
  orderItems          OrderItem[]
  orderPromotions     OrderPromotion[]
  orders              Order[]

  @@index([branchId])
  @@map("promotions")
}

model PromotionCategory {
  promotionId String @map("promotion_id")
  categoryId  String @map("category_id")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionItem {
  promotionId String  @map("promotion_id")
  menuItemId  String  @map("menu_item_id")
  isTarget    Boolean @default(false) @map("is_target")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([promotionId, menuItemId])
  @@index([menuItemId])
  @@map("promotion_items")
}

model OrderPromotion {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  promotionId     String   @map("promotion_id")
  nameSnapshot    String   @map("name_snapshot")
  typeSnapshot    String   @map("type_snapshot")
  valueSnapshot   Decimal  @map("value_snapshot") @db.Decimal(10, 2)
  promotionAmount Decimal  @map("promotion_amount") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([promotionId])
  @@map("order_promotions")
}

model Tip {
  id                  String    @id @default(cuid())
  orderId             String?   @unique @map("order_id")
  paymentId           String?   @unique @map("payment_id")
  amount              Decimal   @db.Decimal(10, 2)
  method              TipMethod @default(FIXED)
  percentage          Decimal?  @db.Decimal(10, 2)
  requestedAmount     Decimal?  @map("requested_amount") @db.Decimal(10, 2)
  tipAmount           Decimal?  @map("tip_amount") @db.Decimal(10, 2)
  cashTipAmount       Decimal?  @map("cash_tip_amount") @db.Decimal(10, 2)
  chargeableTipAmount Decimal?  @map("chargeable_tip_amount") @db.Decimal(10, 2)
  baseAmount          Decimal?  @map("base_amount") @db.Decimal(10, 2)
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])
  user    User?    @relation(fields: [createdBy], references: [id])

  @@map("tips")
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String       @map("payment_id")
  orderId           String       @map("order_id")
  amount            Decimal      @db.Decimal(10, 2)
  reason            String?
  status            RefundStatus @default(PENDING)
  idempotencyKey    String       @unique @map("idempotency_key")
  requestedBy       String?      @map("requested_by")
  createdBy         String?      @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  completedAt       DateTime?    @map("completed_at")
  failedAt          DateTime?    @map("failed_at")
  externalReference String?      @map("external_reference")
  metadata          Json?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// =========================
// Nuevos modelos del dominio
// =========================

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  manager   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          UserBranch[]
  settings       Settings[]
  activities     ActivityLog[]
  orders         Order[]
  discounts      Discount[]
  promotions     Promotion[]
  receipts       Receipt[]
  kitchenTickets KitchenTicket[]
  cashRegisters  CashRegister[]
  tables         RestaurantTable[]

  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]

  @@map("branches")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions  RolePermission[]
  userBranches UserBranch[]

  @@map("roles")
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([roleId])
  @@map("user_branches")
}

model Settings {
  id        String   @id @default(cuid())
  branchId  String   @map("branch_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, key])
  @@map("settings")
}

model ActivityLog {
  id        String   @id @default(cuid())
  branchId  String   @map("branch_id")
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  changes   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@map("activity_logs")
}

model CashRegister {
  id        String             @id @default(cuid())
  branchId  String             @map("branch_id")
  name      String
  status    CashRegisterStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  branch   Branch        @relation(fields: [branchId], references: [id])
  sessions CashSession[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("cash_registers")
}

model CashSession {
  id              String            @id @default(cuid())
  registerId      String            @map("register_id")
  openedBy        String            @map("opened_by")
  closedBy        String?           @map("closed_by")
  status          CashSessionStatus @default(OPEN)
  openingFloat    Decimal           @map("opening_float") @db.Decimal(10, 2)
  expectedCash    Decimal           @map("expected_cash") @db.Decimal(10, 2)
  countedCash     Decimal?          @map("counted_cash") @db.Decimal(10, 2)
  difference      Decimal?          @db.Decimal(10, 2)
  totalPayments   Decimal           @default(0) @map("total_payments") @db.Decimal(10, 2)
  cashPayments    Decimal           @default(0) @map("cash_payments") @db.Decimal(10, 2)
  refunds         Decimal           @default(0) @db.Decimal(10, 2)
  manualMovements Decimal           @default(0) @map("manual_movements") @db.Decimal(10, 2)
  openedAt        DateTime          @default(now()) @map("opened_at")
  closedAt        DateTime?         @map("closed_at")
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  register  CashRegister   @relation(fields: [registerId], references: [id])
  opener    User           @relation("CashSessionOpenedBy", fields: [openedBy], references: [id])
  closer    User?          @relation("CashSessionClosedBy", fields: [closedBy], references: [id])
  movements CashMovement[]
  counts    CashCount[]

  // "cash_session_open_per_register" (única sesión OPEN por caja) es un
  // índice único PARCIAL (WHERE status = 'OPEN'), definido a mano en
  // 20260724010000_add_cash_register_engine. Prisma no puede expresar
  // índices únicos parciales en su DSL — declararlo aquí como @@unique
  // hace que Prisma lo crea "faltante" y regenere uno completo (incorrecto)
  // en cada migrate dev/reset. Se deja fuera del schema a propósito.
  @@index([registerId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id          String           @id @default(cuid())
  sessionId   String           @map("session_id")
  type        CashMovementType
  amount      Decimal          @db.Decimal(10, 2)
  reason      String
  referenceId String?          @map("reference_id")
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  session CashSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [createdBy], references: [id])
  // Idempotency enforced at DB level via partial unique index (migration):
  // CREATE UNIQUE INDEX cash_movement_idempotency
  //   ON cash_movements(session_id, type, reference_id)
  //   WHERE reference_id IS NOT NULL;
  // Prevents duplicate CASH_PAYMENT / CASH_REFUND movements on event retry.

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@map("cash_movements")
}

model CashCount {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  countedCash Decimal  @map("counted_cash") @db.Decimal(10, 2)
  difference  Decimal  @db.Decimal(10, 2)
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  session CashSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [createdBy], references: [id])

  @@index([sessionId])
  @@map("cash_counts")
}

model Receipt {
  id             String  @id @default(cuid())
  orderId        String  @unique @map("order_id")
  folio          String  @unique
  idempotencyKey String  @unique @map("idempotency_key")
  branchId       String? @map("branch_id")
  userId         String? @map("user_id")

  subtotal        Decimal @db.Decimal(12, 2)
  promotionAmount Decimal @map("promotion_amount") @db.Decimal(12, 2)
  discountAmount  Decimal @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal @map("tax_amount") @db.Decimal(12, 2)
  tipAmount       Decimal @map("tip_amount") @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)

  snapshot  Json
  issuedAt  DateTime @default(now()) @map("issued_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([branchId])
  @@index([issuedAt])
  @@map("receipts")
}

model ReceiptSequence {
  id        String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipt_sequences")
}

// =========================
// Módulo de Inventario
// =========================
//
// Visibilidad por rol (se aplica en controladores con @Roles + RolesGuard):
//  - OWNER / ADMIN : gestión completa (proveedores, costos, ajustes, reportes)
//  - MANAGER      : gestión operativa de stock de su sucursal
//  - CHEF / KITCHEN_STAFF : consulta de stock, registro de consumo y merma,
//                            recetas (RecipeIngredient) de los platillos
// El schema soporta esa segmentación vía: movimientos auditados por usuario
// (createdBy), stock segmentado por sucursal (branchId) y costos aislados en
// InventoryItem/InventoryMovement (ocultables por DTO para roles de cocina).

model Supplier {
  id          String   @id @default(cuid())
  name        String   @unique
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items     InventoryItem[]
  movements InventoryMovement[]

  @@map("suppliers")
}

model InventoryItem {
  id          String        @id @default(cuid())
  name        String        @unique
  sku         String?       @unique
  description String?
  unit        InventoryUnit @default(PIECE)
  costPerUnit Decimal       @default(0) @map("cost_per_unit") @db.Decimal(10, 2)
  minStock    Decimal       @default(0) @map("min_stock") @db.Decimal(10, 3)
  maxStock    Decimal?      @map("max_stock") @db.Decimal(10, 3)
  imageUrl    String?       @map("image_url")
  isActive    Boolean       @default(true) @map("is_active")
  supplierId  String?       @map("supplier_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocks            InventoryStock[]
  movements         InventoryMovement[]
  recipeIngredients RecipeIngredient[]

  @@index([supplierId])
  @@map("inventory_items")
}

model InventoryStock {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  branchId  String   @map("branch_id")
  quantity  Decimal  @default(0) @db.Decimal(10, 3)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id])

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("inventory_stocks")
}

model InventoryMovement {
  id         String                @id @default(cuid())
  itemId     String                @map("item_id")
  branchId   String                @map("branch_id")
  type       InventoryMovementType
  // Cantidad siempre positiva; el signo lo determina `type`
  quantity   Decimal               @db.Decimal(10, 3)
  unitCost   Decimal?              @map("unit_cost") @db.Decimal(10, 2)
  totalCost  Decimal?              @map("total_cost") @db.Decimal(12, 2)
  reason     String?
  // Referencia externa (folio de orden, factura de compra, etc.)
  reference  String?
  supplierId String?               @map("supplier_id")
  createdBy  String                @map("created_by")
  createdAt  DateTime              @default(now()) @map("created_at")

  item     InventoryItem @relation(fields: [itemId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  supplier Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user     User          @relation(fields: [createdBy], references: [id])

  @@index([itemId])
  @@index([branchId])
  @@index([type])
  @@index([createdBy])
  @@index([createdAt])
  @@map("inventory_movements")
}

model RecipeIngredient {
  menuItemId      String  @map("menu_item_id")
  inventoryItemId String  @map("inventory_item_id")
  // Cantidad de insumo (en la unidad del InventoryItem) por porción del platillo
  quantity        Decimal @db.Decimal(10, 3)
  notes           String?

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("recipe_ingredients")
}
