// ============================================================
// SCHEMA POR TENANT — aplicado a cada schema de restaurante.
// Migraciones: prisma/tenant/migrations/
// Uso dev: npx prisma migrate dev --schema=prisma/tenant/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ── Enumeraciones ────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  WAITER
  CASHIER
  CHEF
  KITCHEN_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MenuItemStatus {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_STOCK
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  BUY_X_GET_Y
  FREE_ITEM
  SPECIAL_PRICE
  CATEGORY_PERCENTAGE
  CATEGORY_FIXED
}

enum TipMethod {
  NONE
  PERCENTAGE
  FIXED
  CASH
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum KitchenTicketStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CANCELLED
  ARRIVED
  COMPLETED
  NO_SHOW
}

// ── Modelos ──────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(WAITER)
  status       UserStatus @default(ACTIVE)
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  voiceUsername      String?   @unique @map("voice_username")
  voiceSeedHash      String?   @map("voice_seed_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relaciones adicionales para gestión por sucursal y auditoría
  userBranches UserBranch[]
  activityLogs ActivityLog[]

  orders       Order[]
  reservations Reservation[]
  tips         Tip[]

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuItems           MenuItem[]
  promotionCategories PromotionCategory[]

  @@map("categories")
}

model MenuItem {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  imageUrl    String?        @map("image_url")
  status      MenuItemStatus @default(AVAILABLE)
  isAvailable Boolean        @default(true) @map("is_available")
  categoryId  String         @map("category_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  promotionItems PromotionItem[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("menu_items")
}

model RestaurantTable {
  id           String      @id @default(cuid())
  number       Int
  name         String?
  capacity     Int
  status       TableStatus @default(AVAILABLE)
  locationZone String?     @map("location_zone")
  isActive     Boolean     @default(true) @map("is_active")
  branchId     String      @map("branch_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  orders       Order[]
  reservations Reservation[]

  @@unique([number, branchId])
  @@index([branchId])
  @@map("tables")
}

model Order {
  id               String             @id @default(cuid())
  folio            String             @unique
  tableId          String?            @map("table_id")
  branchId         String?            @map("branch_id")
  userId           String             @map("user_id")
  customerName     String?            @map("customer_name")
  type             OrderType          @default(DINE_IN)
  status           OrderStatus        @default(PENDING)
  paymentStatus    OrderPaymentStatus @default(UNPAID) @map("payment_status")
  notes            String?
  subtotal         Decimal            @db.Decimal(10, 2)
  promotionAmount  Decimal?           @map("promotion_amount") @db.Decimal(10, 2)
  promotedSubtotal Decimal?           @map("promoted_subtotal") @db.Decimal(10, 2)
  discountAmount       Decimal?           @db.Decimal(10, 2) @map("discount_amount")
  taxableSubtotal      Decimal?           @db.Decimal(10, 2) @map("taxable_subtotal")
  tax                  Decimal            @db.Decimal(10, 2)
  totalBeforeTip       Decimal?           @map("total_before_tip") @db.Decimal(10, 2)
  tipAmount            Decimal?           @map("tip_amount") @db.Decimal(10, 2)
  cashTipAmount        Decimal?           @map("cash_tip_amount") @db.Decimal(10, 2)
  chargeableTipAmount  Decimal?           @map("chargeable_tip_amount") @db.Decimal(10, 2)
  total                Decimal            @db.Decimal(10, 2)
  amountDueForPayments Decimal?           @map("amount_due_for_payments") @db.Decimal(10, 2)
  discountId           String?            @map("discount_id")
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  /// @deprecated Order.promotionId is deprecated; use OrderPromotion relation for order promotions.
  promotionId String? @map("promotion_id")

  table           RestaurantTable? @relation(fields: [tableId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  discount        Discount?        @relation(fields: [discountId], references: [id])
  promotion       Promotion?       @relation(fields: [promotionId], references: [id])
  tip             Tip?
  orderItems      OrderItem[]
  orderPromotions OrderPromotion[]
  payments        Payment[]
  kitchenTicket   KitchenTicket?

  @@index([userId])
  @@index([tableId])
  @@index([branchId])
  @@index([discountId])
  @@index([promotionId])
  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(cuid())
  orderId                String   @map("order_id")
  menuItemId             String   @map("menu_item_id")
  quantity               Int
  unitPrice              Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal               Decimal  @db.Decimal(10, 2)
  promotionId            String?  @map("promotion_id")
  promotionNameSnapshot  String?  @map("promotion_name_snapshot")
  promotionTypeSnapshot  String?  @map("promotion_type_snapshot")
  promotionValueSnapshot Decimal? @map("promotion_value_snapshot") @db.Decimal(10, 2)
  promotionQuantity      Int?     @map("promotion_quantity")
  promotionAmount        Decimal? @map("promotion_amount") @db.Decimal(10, 2)
  originalUnitPrice      Decimal? @map("original_unit_price") @db.Decimal(10, 2)
  effectiveUnitPrice     Decimal? @map("effective_unit_price") @db.Decimal(10, 2)
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id])
  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@index([promotionId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @map("order_id")
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  reference      String?
  tipAmount      Decimal?      @map("tip_amount") @db.Decimal(10, 2)
  idempotencyKey String?       @unique @map("idempotency_key")
  ticketPdfUrl   String?       @map("ticket_pdf_url")
  processedAt    DateTime?     @map("processed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])
  tip   Tip?

  @@index([orderId])
  @@map("payments")
}

model KitchenTicket {
  id          String              @id @default(cuid())
  orderId     String              @unique @map("order_id")
  status      KitchenTicketStatus @default(PENDING)
  priority    Int                 @default(0)
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @map("completed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("kitchen_tickets")
}

model Reservation {
  id          String            @id @default(cuid())
  branchId    String            @map("branch_id")
  tableId     String            @map("table_id")
  userId      String?           @map("user_id")
  guestName   String            @map("guest_name")
  guestPhone  String?           @map("guest_phone")
  guestEmail  String?           @map("guest_email")
  partySize   Int               @map("party_size")
  scheduledAt DateTime          @map("scheduled_at")
  status      ReservationStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  table RestaurantTable @relation(fields: [tableId], references: [id])
  user  User?           @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([tableId])
  @@index([userId])
  @@map("reservations")
}

model Discount {
  id          String       @id @default(cuid())
  name        String
  description String?
  code        String?      @unique
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2)
  isActive    Boolean      @default(true) @map("is_active")
  branchId    String?      @map("branch_id")
  startsAt    DateTime?    @map("starts_at")
  endsAt      DateTime?    @map("ends_at")
  minPurchase Decimal?     @map("min_purchase") @db.Decimal(10, 2)
  maxAmount   Decimal?     @map("max_amount") @db.Decimal(10, 2)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  branch Branch? @relation(fields: [branchId], references: [id])
  orders Order[]

  @@index([branchId])
  @@map("discounts")
}

model Promotion {
  id           String        @id @default(cuid())
  name         String
  description  String?
  type         PromotionType
  value        Decimal       @db.Decimal(10, 2)
  minPurchase  Decimal?      @map("min_purchase") @db.Decimal(10, 2)
  maxAmount    Decimal?      @map("max_amount") @db.Decimal(10, 2)
  specialPrice Decimal?      @map("special_price") @db.Decimal(10, 2)
  buyQuantity  Int?          @map("buy_quantity")
  getQuantity  Int?          @map("get_quantity")
  startsAt     DateTime?     @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  startMinute  Int?          @map("start_minute")
  endMinute    Int?          @map("end_minute")
  priority     Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  branchId     String?       @map("branch_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  branch              Branch?             @relation(fields: [branchId], references: [id])
  promotionCategories PromotionCategory[]
  promotionItems      PromotionItem[]
  orderItems          OrderItem[]
  orderPromotions     OrderPromotion[]
  orders              Order[]

  @@index([branchId])
  @@map("promotions")
}

model PromotionCategory {
  promotionId String @map("promotion_id")
  categoryId  String @map("category_id")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionItem {
  promotionId String  @map("promotion_id")
  menuItemId  String  @map("menu_item_id")
  isTarget    Boolean @default(false) @map("is_target")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([promotionId, menuItemId])
  @@index([menuItemId])
  @@map("promotion_items")
}

model OrderPromotion {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  promotionId     String   @map("promotion_id")
  nameSnapshot    String   @map("name_snapshot")
  typeSnapshot    String   @map("type_snapshot")
  valueSnapshot   Decimal  @db.Decimal(10, 2) @map("value_snapshot")
  promotionAmount Decimal  @db.Decimal(10, 2) @map("promotion_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([promotionId])
  @@map("order_promotions")
}

model Tip {
  id                  String    @id @default(cuid())
  orderId             String?   @unique @map("order_id")
  paymentId           String?   @unique @map("payment_id")
  amount              Decimal   @db.Decimal(10, 2)
  method              TipMethod @default(FIXED)
  percentage          Decimal?  @db.Decimal(10, 2)
  requestedAmount     Decimal?  @map("requested_amount") @db.Decimal(10, 2)
  tipAmount           Decimal?  @map("tip_amount") @db.Decimal(10, 2)
  cashTipAmount       Decimal?  @map("cash_tip_amount") @db.Decimal(10, 2)
  chargeableTipAmount Decimal?  @map("chargeable_tip_amount") @db.Decimal(10, 2)
  baseAmount          Decimal?  @map("base_amount") @db.Decimal(10, 2)
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  order               Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment?  @relation(fields: [paymentId], references: [id])
  user                User?     @relation(fields: [createdBy], references: [id])

  @@map("tips")
}

// =========================
// Nuevos modelos del dominio
// =========================

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  manager   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      UserBranch[]
  settings   Settings[]
  activities ActivityLog[]
  orders     Order[]
  discounts  Discount[]
  promotions Promotion[]

  @@map("branches")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions  RolePermission[]
  userBranches UserBranch[]

  @@map("roles")
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([roleId])
  @@map("user_branches")
}

model Settings {
  id        String   @id @default(cuid())
  branchId  String   @map("branch_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, key])
  @@map("settings")
}

model ActivityLog {
  id        String   @id @default(cuid())
  branchId  String   @map("branch_id")
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  changes   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@map("activity_logs")
}
