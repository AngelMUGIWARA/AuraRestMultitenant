# ============================================================
# DEPLOY EC2 (AWS Academy Lab) — Referencia de variables
# ============================================================
# Copia/edita los valores de este archivo en cada .env del proyecto
# y reemplaza <EC2_PUBLIC_HOST> por la IP pública o DNS de tu EC2
# (ej: 3.215.100.50 o ec2-3-215-100-50.compute-1.amazonaws.com).
#
# Los archivos .env reales están en .gitignore (no se versionan).
# Este archivo de ejemplo SÍ está versionado (solo placeholders).
#
# Origenes y puertos:
#   shell  :3030   core_auth_dashboard_mf :5011
#   orders_tables_mf :5012   reservations_reports_mf :5013
#   menu-mf :5003   kitchen-mf :5005   cashier-mf :5006
#   backend API :4000  (Swagger: /api/docs)

# ══════════════════════════════════════════════════════════════
# 1) apps/backend/.env  (lo lee el backend NestJS)
# ══════════════════════════════════════════════════════════════
PORT=4000
NODE_ENV=production

DATABASE_URL="postgresql://postgres:adminadmin@aura-rest.cyodzozkjmfc.us-east-1.rds.amazonaws.com:5432/aurarest_db?schema=public&sslmode=require"
TENANT_DATABASE_URL="postgresql://postgres:adminadmin@aura-rest.cyodzozkjmfc.us-east-1.rds.amazonaws.com:5432/aurarest_db?schema=tenant_ejemplo&sslmode=require"

JWT_SECRET="<SECRET_1_MIN_32_CHARS_UNICO>"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="<SECRET_2_MIN_32_CHARS_UNICO>"
JWT_REFRESH_EXPIRES_IN="7d"

SYSTEM_JWT_SECRET="<SECRET_3_MIN_32_CHARS_UNICO>"
SYSTEM_JWT_EXPIRES_IN="2h"
SYSTEM_JWT_REFRESH_SECRET="<SECRET_4_MIN_32_CHARS_UNICO>"
SYSTEM_JWT_REFRESH_EXPIRES_IN="30d"

# Orígenes de los frontends (navegador -> API)
CORS_ORIGINS="http://<EC2_PUBLIC_HOST>:3030,http://<EC2_PUBLIC_HOST>:5003,http://<EC2_PUBLIC_HOST>:5005,http://<EC2_PUBLIC_HOST>:5006,http://<EC2_PUBLIC_HOST>:5011,http://<EC2_PUBLIC_HOST>:5012,http://<EC2_PUBLIC_HOST>:5013"

BCRYPT_ROUNDS=10
CLOUDINARY_CLOUD_NAME=yr2yb33w
CLOUDINARY_API_KEY=969837584147714
CLOUDINARY_API_SECRET=ppPqDiLBAwMx21RWLIO7HeoThZo
SWAGGER_ENABLED=true

# ══════════════════════════════════════════════════════════════
# 2) apps/web-shell/.env  (lo lee next dev en apps/web-shell)
# ══════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://<EC2_PUBLIC_HOST>:4000/api/v1
NEXT_PUBLIC_MFE_CORE_AUTH_DASHBOARD_URL=http://<EC2_PUBLIC_HOST>:5011/remoteEntry.js
NEXT_PUBLIC_MFE_ORDERS_TABLES_URL=http://<EC2_PUBLIC_HOST>:5012/remoteEntry.js
NEXT_PUBLIC_MFE_RESERVATIONS_REPORTS_URL=http://<EC2_PUBLIC_HOST>:5013/remoteEntry.js
NEXT_PUBLIC_MFE_KITCHEN_URL=http://<EC2_PUBLIC_HOST>:5005/remoteEntry.js
NEXT_PUBLIC_MFE_CASHIER_URL=http://<EC2_PUBLIC_HOST>:5006/remoteEntry.js
NEXT_PUBLIC_MFE_MENU_URL=http://<EC2_PUBLIC_HOST>:5003/remoteEntry.js
# Host para allowedDevOrigins de Next.js dev (HMR/fuentes) — mismo valor que EC2_PUBLIC_HOST
NEXT_PUBLIC_DEV_ORIGIN=<EC2_PUBLIC_HOST>

# ══════════════════════════════════════════════════════════════
# 3) .env de cada MFE Vite (apps/<mfe>/.env)
# ══════════════════════════════════════════════════════════════
# En apps/menu-mf, apps/kitchen-mf, apps/cashier-mf,
#    apps/core_auth_dashboard_mf, apps/orders_tables_mf,
#    apps/reservations_reports_mf/.env
VITE_API_URL=http://<EC2_PUBLIC_HOST>:4000/api/v1
VITE_HMR_HOST=<EC2_PUBLIC_HOST>

# ══════════════════════════════════════════════════════════════
# 4) Generar secrets seguros (opcional, ya generados en los .env)
# ══════════════════════════════════════════════════════════════
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ══════════════════════════════════════════════════════════════
# PASOS EN EL EC2
# ══════════════════════════════════════════════════════════════
# 1. Clonar y reemplazar <EC2_PUBLIC_HOST> en todos los .env.
# 2. pnpm install
# 3. Migraciones + seed a RDS:
#      pnpm db:deploy
#      pnpm db:seed
#      pnpm db:seed:admin
# 4. Levantar frontends + backend:
#      pnpm dev:all       (en una terminal)
#      pnpm dev:backend   (en otra)
#    o en una sola: pnpm dev:ec2
# 5. Acceder desde cualquier navegador:
#      http://<EC2_PUBLIC_HOST>:3030
#      http://<EC2_PUBLIC_HOST>:4000/api/docs (Swagger)
#
# ── AWS Console (Security Group de la instancia) ──────────────
# Abrir entrantes TCP: 3030, 4000, 5003, 5005, 5006, 5011, 5012, 5013
# desde 0.0.0.0/0 (o solo tu IP para menor exposición).
#
# ── RDS ───────────────────────────────────────────────────────
# El Security Group del RDS debe permitir conexiones desde el
# Security Group del EC2 en el puerto 5432.
