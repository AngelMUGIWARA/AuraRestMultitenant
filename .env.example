# ── Frontend (MFEs) ───────────────────────────────────────────

# API base URL para todos los MFEs (Vite)
VITE_API_URL=http://localhost:4000/api/v1

# URLs de cada MFE (sobrescribe los defaults del federation.ts del web-shell)
# NOTA: Solo incluir las URLs que EXISTEN en el sistema actual.
# Para cambiar URLs en producción, modifica estas variables.

# CORE: Authentication + Dashboard + Admin (5011)
NEXT_PUBLIC_MFE_CORE_AUTH_DASHBOARD_URL=http://localhost:5011/remoteEntry.js

# ORDERS & TABLES: Órdenes y gestión de mesas (5012)
NEXT_PUBLIC_MFE_ORDERS_TABLES_URL=http://localhost:5012/remoteEntry.js

# RESERVATIONS & REPORTS: Reservaciones e informes (5013)
NEXT_PUBLIC_MFE_RESERVATIONS_REPORTS_URL=http://localhost:5013/remoteEntry.js

# KITCHEN: Pantalla de cocina (5005)
NEXT_PUBLIC_MFE_KITCHEN_URL=http://localhost:5005/remoteEntry.js

# CASHIER: Caja registradora (5006)
NEXT_PUBLIC_MFE_CASHIER_URL=http://localhost:5006/remoteEntry.js

# MENU: Gestión de menú (5003)
NEXT_PUBLIC_MFE_MENU_URL=http://localhost:5003/remoteEntry.js

# ── Backend (ver apps/backend/.env.example para detalle completo) ─
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura_rest"
TENANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura_rest?schema=tenant_ejemplo"
JWT_SECRET="cambia_este_secreto_por_uno_seguro_en_produccion"
JWT_REFRESH_SECRET="cambia_este_secreto_por_otro_seguro_en_produccion"
